# DevConnector — environment configuration
# Copy to `.env` (never committed). Every value can also come from the process environment.
# Defaults in brackets apply when a variable is unset.

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development                 # development | production | test
PORT=3000                            # API listen port [3000 in dev, 8080 in the container]
APP_URL=http://localhost:5173        # public base URL of the app: links in e-mails, OAuth callback, cookie flags
TRUST_PROXY=false                    # true when behind Nginx Proxy Manager / any reverse proxy (X-Forwarded-*)
LOG_LEVEL=debug                      # fatal | error | warn | info | debug | trace [info]

# ── Database (PostgreSQL 18) ─────────────────────────────────────────────────
DATABASE_URL=postgres://devconnector:devconnector@localhost:5432/devconnector
MIGRATE_ON_START=true                # apply pending SQL migrations when the API boots [true]

# ── Authentication ───────────────────────────────────────────────────────────
AUTH_SECRET=change-me-to-a-random-string-of-at-least-32-characters   # signs OAuth state cookies; `openssl rand -base64 48`
AUTH_REQUIRE_EMAIL_VERIFICATION=true # block login until the e-mail is verified [true]
SESSION_TTL_DAYS=30                  # absolute session lifetime [30]
COOKIE_SECURE=auto                   # auto (Secure when APP_URL is https) | true | false

# GitHub OAuth App (optional — the button is hidden when unset).
# Callback URL to register on GitHub: ${APP_URL}/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# First admin: created on the first boot of an EMPTY database, then ignored.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ── E-mail (SMTP) ────────────────────────────────────────────────────────────
# Dev: Mailpit from compose.yml (SMTP 1025, web UI http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false                    # true for implicit TLS (465); STARTTLS is negotiated automatically on 587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="DevConnector <no-reply@localhost>"

# ── Files ────────────────────────────────────────────────────────────────────
UPLOADS_DIR=./data/uploads           # avatar storage (a volume in Docker: /data/uploads)
MAX_UPLOAD_MB=2

# ── Rate limiting (requests per window) ──────────────────────────────────────
RATE_LIMIT_LOGIN_PER_MINUTE=10       # per IP on /auth/login
RATE_LIMIT_API_PER_MINUTE=300        # per IP on /api

# ── Web (Vite dev server only) ───────────────────────────────────────────────
VITE_API_PROXY_TARGET=http://localhost:3000
